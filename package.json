{
  "name": "fe-web-ban-xa-phong",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "json-server --watch db.json --port 3001",
    "payment": "node --experimental-strip-types --env-file-if-exists=server/.env server/index.ts",
    "payment:tunnel": "cloudflared tunnel --url http://127.0.0.1:3003",
    "build": "vite build",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fortawesome/free-regular-svg-icons": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/react-fontawesome": "^3.5.0",
    "@reduxjs/toolkit": "^2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-paginate": "^8.3.0",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "json-server": "^1.0.0-beta.15",
    "oxlint": "^1.88.0",
    "sass-embedded": "^1.108.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
